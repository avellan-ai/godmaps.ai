// The public hostname is not here. boat-deploy.sh passes it to wrangler from
// ../config.json, so deploy with `deploy/boat-deploy.sh worker`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "godmaps",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "KEEPER", "class_name": "SandboxKeeper" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SandboxKeeper"] }],
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "4173",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
}
